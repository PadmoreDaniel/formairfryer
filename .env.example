# Firebase (existing app config)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# OpenAI (AI form generator)
REACT_APP_OPENAI_API_KEY=
REACT_APP_OPENAI_MODEL=gpt-4

# ------------------------------------------------------------------
# Analytics
# ------------------------------------------------------------------
# Ingestion endpoint baked into EXPORTED plugins (from `serverless deploy`
# output of the formair-analytics `ingest` function, e.g.
# https://xxxx.execute-api.eu-west-1.amazonaws.com/v1/events).
REACT_APP_ANALYTICS_ENDPOINT=

# Write key baked into exported plugins. Must be one of ANALYTICS_WRITE_KEYS
# configured on the analytics backend.
REACT_APP_ANALYTICS_WRITE_KEY=

# Authenticated read API base URL used by the dashboard (the stage base URL,
# e.g. https://xxxx.execute-api.eu-west-1.amazonaws.com). The service appends
# /v1/analytics/{formId}.
REACT_APP_ANALYTICS_API=
